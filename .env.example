# Supabase Project Connection Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials

# Supabase Project URL (found in Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous API Key (found in Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
